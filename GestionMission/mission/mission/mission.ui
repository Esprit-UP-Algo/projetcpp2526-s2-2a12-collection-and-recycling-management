  <property name="styleSheet">
   <string notr="true">
    /* Style principal - Fond noir */
    QMainWindow {
        background-color: #1E1E1E;
    }

    QWidget#centralwidget {
        background-color: #1E1E1E;
    }

    /* Style de la sidebar */
    #sidebar {
        background-color: #2D2D2D;
        border-right: 1px solid #3D3D3D;
    }

    #sidebar QPushButton {
        background: transparent;
        border: none;
        padding: 12px;
        text-align: left;
        font-size: 14px;
        color: #FFFFFF;
        border-radius: 5px;
        margin: 2px 8px;
    }

    #sidebar QPushButton:hover {
        background-color: #9BE15D;
        color: #1E1E1E;
    }

    #sidebar QLabel {
        color: #9BE15D;
        font-weight: bold;
        padding-left: 12px;
        padding-top: 15px;
    }

    #sidebar QLabel#labelTitleSidebar {
        color: #FFFFFF;
        font-size: 16px;
        padding: 20px 12px;
        border-bottom: 1px solid #3D3D3D;
    }

    /* Style des groupes */
    QGroupBox {
        font-weight: bold;
        border: 1px solid #3D3D3D;
        border-radius: 10px;
        margin-top: 10px;
        padding-top: 10px;
        background-color: #2D2D2D;
        color: #FFFFFF;
    }

    QGroupBox::title {
        subcontrol-origin: margin;
        left: 20px;
        padding: 0 10px 0 10px;
        color: #9BE15D;
    }

    /* Style des tableaux */
    QTableView, QTableWidget {
        background-color: #2D2D2D;
        border-radius: 10px;
        gridline-color: #3D3D3D;
        selection-background-color: #9BE15D;
        selection-color: #1E1E1E;
        alternate-background-color: #353535;
        color: #FFFFFF;
    }

    QTableView::item:hover, QTableWidget::item:hover {
        background-color: rgba(155, 225, 93, 0.3);
    }

    QTableView::item, QTableWidget::item {
        padding: 5px;
        border-bottom: 1px solid #3D3D3D;
    }

    /* Style des en-têtes de tableau */
    QHeaderView::section {
        background-color: #1E1E1E;
        color: #9BE15D;
        padding: 10px;
        font-weight: bold;
        border: none;
        border-bottom: 2px solid #9BE15D;
    }

    /* Style des boutons */
    QPushButton {
        background-color: #7ED957;
        color: #1E1E1E;
        border-radius: 5px;
        padding: 10px;
        font-size: 14px;
        font-weight: bold;
        border: none;
    }

    QPushButton:hover {
        background-color: #6AC94F;
    }

    QPushButton.btnDanger {
        background-color: #FF6B6B;
        color: white;
    }

    QPushButton.btnDanger:hover {
        background-color: #FF5252;
    }

    QPushButton#btnLogout {
        background-color: transparent;
        color: #FF6B6B;
        border: 1px solid #FF6B6B;
    }

    QPushButton#btnLogout:hover {
        background-color: #FF6B6B;
        color: white;
    }

    /* Style des labels */
    QLabel {
        color: #FFFFFF;
        font-size: 13px;
    }

    QLabel[bold="true"] {
        font-weight: bold;
        color: #9BE15D;
    }

    /* Style des champs de saisie */
    QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit, QTextEdit {
        border: 1px solid #3D3D3D;
        border-radius: 5px;
        padding: 8px;
        background-color: #353535;
        color: #FFFFFF;
        font-size: 13px;
    }

    QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QDateEdit:focus, QTimeEdit:focus, QTextEdit:focus {
        border: 1px solid #9BE15D;
        background-color: #404040;
    }

    QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover, QDateEdit:hover, QTimeEdit:hover, QTextEdit:hover {
        border: 1px solid #9BE15D;
    }

    /* Style des combobox dropdown */
    QComboBox QAbstractItemView {
        background-color: #2D2D2D;
        color: #FFFFFF;
        selection-background-color: #9BE15D;
        selection-color: #1E1E1E;
        border: 1px solid #3D3D3D;
    }

    /* Style de la barre de statut */
    QStatusBar {
        background-color: #2D2D2D;
        color: #9BE15D;
        border-top: 1px solid #3D3D3D;
    }

    /* Style de la barre de recherche */
    QLineEdit#rechercheMission {
        background-color: #353535;
        color: #FFFFFF;
        border: 1px solid #3D3D3D;
    }

    QLineEdit#rechercheMission:focus {
        border: 1px solid #9BE15D;
    }
   </string>
